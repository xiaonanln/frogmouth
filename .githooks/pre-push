#!/usr/bin/env bash
# Block direct pushes to main — every change goes through a PR.
# Enable with: git config core.hooksPath .githooks
set -euo pipefail

protected='^refs/heads/(main|master)$'
blocked=0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [[ "$remote_ref" =~ $protected ]]; then
    blocked=1
  fi
done

if [[ $blocked -eq 1 ]]; then
  cat >&2 <<'MSG'

  x Direct pushes to main are not allowed.

    Every change goes through a pull request:
      git switch -c <branch>
      git push -u origin <branch>
      gh pr create

MSG
  exit 1
fi

if [[ -d host/tests ]]; then
  echo "  -> running tests"
  if ! python3 -m unittest discover -s host/tests -p 'test_*.py' -q; then
    echo "  x tests failed, push aborted" >&2
    exit 1
  fi
fi

exit 0
