#!/usr/bin/env bash
# Block direct pushes to main, then run presubmit checks.
# Enable with: git config core.hooksPath .githooks
set -euo pipefail

protected='^refs/heads/(main|master)$'
blocked=0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [[ "$remote_ref" =~ $protected ]]; then
    blocked=1
  fi
done

if [[ $blocked -eq 1 ]]; then
  cat >&2 <<'MSG'

  x Direct pushes to main are not allowed.

    Every change goes through a pull request:
      git switch -c <branch>
      git push -u origin <branch>
      gh pr create

MSG
  exit 1
fi

echo "presubmit:"
if ! python3 "$(git rev-parse --show-toplevel)/scripts/presubmit.py"; then
  echo "  push aborted" >&2
  exit 1
fi

exit 0
